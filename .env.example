# Database Configuration
# MySQL connection settings for ibunbaz_drais database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-database-password
DB_PASS=your-database-password
DB_NAME=ibunbaz_drais
DB_PORT=3306

# Alternative MySQL configuration variables
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-database-password
MYSQL_DB=ibunbaz_drais

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./public/uploads

# For Vercel deployment: Set these variables in your Vercel project settings
# Environment Variables section. Never commit .env.local to version control.

# JETON Internal Control Layer
# Generate a new key: node -e "require('crypto').randomBytes(32).toString('hex')"
JETON_API_KEY=your-jeton-api-key-min-32-chars

# ─────────────────────────────────────────────────────────────────────────────
# JETON EXTERNAL CONTROL CHANNEL  (/api/control)
# REQUIRED — system will refuse all control requests if these are absent.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
CONTROL_API_KEY=your-control-api-key-min-32-chars
CONTROL_API_SECRET=your-control-api-secret-min-48-chars

# Optional: whitelist specific Jeton server IPs (comma-separated).
# Leave unset to disable whitelisting (trust network-layer controls instead).
# CONTROL_ALLOWED_IPS=1.2.3.4,5.6.7.8

# Required to release/acquire/decommission a biometric device (ownership ceremony). Set to a shared operator secret.
DEVICE_CLAIM_SECRET=

# ── Hybrid DB mode (online TiDB / local MySQL) ──
# Allow switching to local MySQL (desktop/packaged builds only). Leave unset on hosted.
DRAIS_ALLOW_LOCAL=
# Default mode when local is allowed: online | local
DRAIS_DB_MODE=online
# Local MySQL connection (used only in local mode)
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_DATABASE=drais

# ── Nexus (school-records assistant) ────────────────────────────────────────
# Any OpenAI-compatible provider. A key saved via Settings → Nexus takes
# precedence over these; these are the fallback for local dev and for hosts
# that manage secrets as environment config.
# NOTE: .env.local is gitignored and LOCAL ONLY — production needs these set
# in the hosting environment (Vercel project settings), not in a file.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://api.x.ai/v1
NEXUS_MODEL=grok-3-mini
