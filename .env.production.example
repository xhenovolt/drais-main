# DRAIS — production env for the Electron Windows bundle.
#
# Copy this file to `.env.production` on the Windows build machine
# BEFORE running `npm run build:electron` or `npm run dist:win`.
# Next.js inlines NEXT_PUBLIC_* values at build time and reads the
# rest at runtime from process.env, so values must be present at
# build time for the bundle to be self-contained.
#
# Anything left as `CHANGE_ME` will break the relevant feature at
# runtime; fill them in before shipping the .exe to a school.

# ── Embedded server ──────────────────────────────────────────────
# Port the Electron app binds to. ZK devices on the LAN POST to
# http://<this-pc-lan-ip>:<DRAIS_PORT>/iclock/cdata
# 3210 is the default to avoid conflicting with common 3000-using tools.
DRAIS_PORT=3210
NODE_ENV=production

# ── Database (TiDB cloud) ────────────────────────────────────────
# Use the same TiDB credentials the cloud deployment uses. The
# Windows PC needs outbound internet to reach TiDB.
DB_HOST=CHANGE_ME.tidbcloud.com
DB_PORT=4000
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=CHANGE_ME

# Mirror keys for libs that read the MYSQL_* names instead.
MYSQL_HOST=CHANGE_ME.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=CHANGE_ME

# ── Session / auth secrets ───────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
REFRESH_SECRET=CHANGE_ME
ADMIN_SECRET=CHANGE_ME

# ── Jeton control channel (optional but used by /api/control) ────
JETON_API_KEY=CHANGE_ME
CONTROL_API_KEY=CHANGE_ME
CONTROL_API_SECRET=CHANGE_ME

# ── External integrations (leave blank to disable the feature) ───
# Cloudinary — student/staff photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Africa's Talking — SMS notifications
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
