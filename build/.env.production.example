# DRAIS desktop — bundled default config (EXAMPLE).
#
# Copy to build/.env.production (gitignored) on the build machine BEFORE
# `npm run dist:win` / `dist:linux` to ship a default config inside the app.
# Alternatively, leave it out and place these keys in the user's
# userData/drais.env after install (the app shows a diagnostic screen until
# DB settings resolve). NEVER commit real secrets.
#
# DRAIS desktop supports two explicit connection choices at login:
# Local MySQL (offline/LAN) and TiDB Cloud (online). Startup connects to neither.

TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB=drais

# Local MySQL — used only after the user selects "Offline (Local MySQL)".
# Install and start MySQL/XAMPP and create this database on the PC first.
DRAIS_ALLOW_LOCAL=true
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_DATABASE=drais

# Optional
DRAIS_PORT=3210
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
