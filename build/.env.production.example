# DRAIS desktop — bundled default config (EXAMPLE).
#
# Copy to build/.env.production (gitignored) on the build machine BEFORE
# `npm run dist:win` / `dist:linux` to ship a default config inside the app.
# Alternatively, leave it out and place these keys in the user's
# userData/drais.env after install (the app shows a diagnostic screen until
# DB settings resolve). NEVER commit real secrets.
#
# DRAIS desktop is ONLINE (connects to TiDB Cloud). Internet is required.

TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB=drais

# Optional
DRAIS_PORT=3210
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
