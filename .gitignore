# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
workers/node_modules
workers/dist
workers/drais-relay.config.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production / electron-builder buildResources
# /build itself stays as the buildResources directory; ignore unknown
# files inside it but track our installer assets (license, icon).
# (Using /build/* + targeted negations because a blanket /build ignore
# would prevent any child re-inclusion per gitignore semantics.)
/build/*
!/build/.gitkeep
!/build/license.txt
!/build/icon.ico

# electron-builder output
/dist/
/release/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The .example files are templates, not secrets — track them.
!.env.example
!.env.local.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
cookies.txt

# Ignore large files
.next/cache/webpack/server-production/*.pack
workers/dist-gui/linux-unpacked/drais-relay
workers/dist-gui/DRAIS Relay-2.0.0.AppImage
workers/dist-gui/win-unpacked/DRAIS Relay.exe
workers/dist/DRAIS-Relay-Windows.zip

# Ignore relay installers
/BACKUP/RELAY-INSTALLERS/*
*.zip
exports/

# Platform-API local artifacts
.secrets/
.dev.log
