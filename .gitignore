# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
workers/node_modules
workers/dist
workers/drais-relay.config.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production / electron-builder buildResources
# /build itself stays as the buildResources directory; ignore unknown
# files inside it but track our installer assets (license, icon).
# (Using /build/* + targeted negations because a blanket /build ignore
# would prevent any child re-inclusion per gitignore semantics.)
/build/*
!/build/.gitkeep
!/build/license.txt
!/build/icon.ico
!/build/icon.png
!/build/README.md
!/build/.env.production.example

# electron-builder output
/dist/
/release/

# Capacitor / Android — track sources, ignore build outputs.
# The mirrored Next standalone tree in mobile/nodejs-project/ is
# regenerated by scripts/build-mobile.mjs on every build, so we only
# track the entrypoint + manifest there.
/mobile/nodejs-project/*
!/mobile/nodejs-project/main.js
!/mobile/nodejs-project/package.json
# Android gradle outputs
/android/.gradle/
/android/build/
/android/app/build/
/android/capacitor-cordova-android-plugins/build/
/android/local.properties
# nodejs-mobile prebuilt binaries (~51 MB across ABIs) and Node
# headers — regenerated by `cap sync android` from
# node_modules/nodejs-mobile-cordova on the build machine. Keeps the
# repo lean. The CMakeLists.txt + C++ glue stay tracked so the
# native build still has the cmake instructions.
/android/capacitor-cordova-android-plugins/src/main/libs/cdvnodejsmobile/bin/
/android/capacitor-cordova-android-plugins/src/main/libs/cdvnodejsmobile/include/
# Capacitor copies the standalone tree into the APK's assets folder
# at sync time — same regenerated-on-build rule.
/android/app/src/main/assets/nodejs-project/
/android/app/src/main/assets/public/_next/
/android/app/src/main/assets/public/standalone/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The .example files are templates, not secrets — track them.
!.env.example
!.env.local.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
cookies.txt

# Ignore large files
.next/cache/webpack/server-production/*.pack
workers/dist-gui/linux-unpacked/drais-relay
workers/dist-gui/DRAIS Relay-2.0.0.AppImage
workers/dist-gui/win-unpacked/DRAIS Relay.exe
workers/dist/DRAIS-Relay-Windows.zip

# Ignore relay installers
/BACKUP/RELAY-INSTALLERS/*
*.zip
exports/

# Platform-API local artifacts
.secrets/
.dev.log

# DB schema exports (generated; may contain seed data)
database/exports/

# Built relay binaries (regenerate via workers/relay-app/build.sh)
workers/dist/drais-relay*
workers/dist/*.zip
drais-relay.apk

# Local-only reference material (one-off forensic/debug scripts, data dumps)
archive/
# Production-data rollback backups (phase1 repairs, dvcf rows)
backups/
