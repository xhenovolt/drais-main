# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=drais_school

# Alternative MySQL naming convention
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=drais_school

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_32_characters_minimum
REFRESH_SECRET=your_refresh_secret_here_32_characters_minimum

# Environment
NODE_ENV=development

# Admin Bootstrap Secret (for first user creation)
ADMIN_SECRET=your_admin_bootstrap_secret_here
