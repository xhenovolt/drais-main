# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=drais_school

# Alternative MySQL naming convention
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=drais_school

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_32_characters_minimum
REFRESH_SECRET=your_refresh_secret_here_32_characters_minimum

# Environment
NODE_ENV=development

# Admin Bootstrap Secret (for first user creation)
ADMIN_SECRET=your_admin_bootstrap_secret_here

# Required to release/acquire/decommission a biometric device (ownership ceremony). Set to a shared operator secret.
DEVICE_CLAIM_SECRET=

# ── Hybrid DB mode (online TiDB / local MySQL) ──
# Allow switching to local MySQL (desktop/packaged builds only). Leave unset on hosted.
DRAIS_ALLOW_LOCAL=
# Default mode when local is allowed: online | local
DRAIS_DB_MODE=online
# Local MySQL connection (used only in local mode)
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_DATABASE=drais
